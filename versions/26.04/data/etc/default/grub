# AsthelOS GRUB2 Default Configuration (/etc/default/grub)
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="AsthelOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 rd.udev.log_priority=3"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=1920x1080,1600x900,1366x768,1280x800,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME="/boot/grub/themes/asthel-os/theme.txt"
GRUB_DISABLE_OS_PROBER=false
